{
  "Logging": {
    "prefix": "cslog",
    "body": [
      "println!(\"${1}: {}\", ${2});"
    ]
  },
  "Logging2": {
    "prefix": "calog",
    "body": [
      "println!(\"${1}: {:?}\", ${2});"
    ]
  },
  "Debug": {
    "prefix": "debug",
    "body": [
      "debug!(\"${1}:\", ${2});"
    ]
  }
}

